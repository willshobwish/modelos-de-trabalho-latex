}

% Ambiente para citações longas (mais de três linhas)
\newenvironment{longcite}{%
    \vspace{5mm}\hfill\begin{minipage}[c]{120mm}\setstretch{1.0}\small
}{%
    \end{minipage}\vspace{5mm}
}

