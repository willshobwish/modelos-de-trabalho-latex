% Margens e geometria da página
\usepackage[a4paper, left=30mm, right=20mm, top=30mm, bottom=20mm]{geometry}

% Cabeçalho e rodapé
\usepackage{fancyhdr}
\pagestyle{fancy}
\fancyhf{}
\fancyhead[R]{\thepage}
\renewcommand{\headrulewidth}{0pt}
\renewcommand{\footrulewidth}{0pt}
\fancypagestyle{plain}{
  \fancyhf{}
  \fancyhead[R]{\thepage}
}

% Tabelas
\usepackage{multirow}
